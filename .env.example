# ---------------------------------------------------------------------------
# Eventerz mobile — environment
#
# Copy to `.env` and restart Metro. Only `EXPO_PUBLIC_*` variables are readable
# from app code; anything without that prefix stays server-side.
#
#   cp .env.example .env
#
# NOTE: EXPO_PUBLIC_* values are inlined into the JS bundle at build time.
# Never put a secret (private key, service-role key, signing seed) in here.
# ---------------------------------------------------------------------------

# --- Solana ----------------------------------------------------------------
# mainnet-beta | devnet | testnet
EXPO_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoint. Leave blank to use the public cluster endpoint.
EXPO_PUBLIC_HELIUS_RPC_URL=

# Deployed Anchor program that owns events / RSVPs / check-ins.
#
# Leave BLANK until it is deployed. Every Eventerz-program action checks this and
# refuses cleanly when unset rather than fabricating a signature — RSVPs and
# tickets are real Postgres records without it.
#
# Sending SOL is the exception: a `transfer` intent is a System Program
# instruction and works regardless of this value.
#
# Deploy from `../Eventerz Program` (see that README), then paste the address
# `anchor keys sync` printed. Inlined at build time, so a change needs a rebuild.
EXPO_PUBLIC_EVENTERZ_PROGRAM_ID=

# Bubblegum merkle tree that compressed NFT tickets mint into.
EXPO_PUBLIC_MERKLE_TREE_ADDRESS=

# --- Feature flags ---------------------------------------------------------
# Wallets. `true` uses the in-memory mock adapter (works in Expo Go).
# Set to `false` only in a development build that has Mobile Wallet Adapter
# installed — see src/services/wallet/mobile-wallet-adapter.ts.
EXPO_PUBLIC_USE_MOCK_WALLET=true

# Data. `true` reads from src/mock via the repositories. Set `false` once a
# backend exists and the repositories call the API client instead.
EXPO_PUBLIC_USE_MOCK_DATA=true

EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_ENABLE_BIOMETRICS=false

# --- Auth (Supabase) -------------------------------------------------------
# Fill these two in to turn on real Google sign-in. Leave them blank and the
# app runs on mock data with the mock wallet, exactly as it does today.
#
# Dashboard → Project Settings → API. Full walkthrough in docs/AUTH_SETUP.md.
#
# The anon key is safe to ship — it is public by design and RLS is what
# protects your data. Never put the service_role key in an EXPO_PUBLIC_ var.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Maps (optional) ------------------------------------------------
# Optional on purpose. With a key, event screens show a Static Maps image and the
# create form uses Google Places autocomplete. Without one, place search falls
# back to OpenStreetMap/Nominatim and the map card shows the address instead of
# an image. "Open in Maps" and "Directions" work either way — they use the
# keyless `?api=1` URL scheme and hand off to the native Maps app.
#
# Restrict the key to your Android package name + SHA-1 in Google Cloud Console.
# APIs to enable: Maps Static API, Places API (New).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Backend (optional) ----------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=
