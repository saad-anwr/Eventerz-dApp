# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native / signing material
.kotlin/
*.orig.*
*.jks
*.keystore
# `eas credentials` writes the keystore and its passwords here when you export
# them for a local build. It is the signing identity in plaintext - committing
# it hands anyone the ability to ship an update as us.
credentials.json
*.p8
*.p12
*.key
*.mobileprovision
id_rsa
id_ed25519

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# JetBrains IDE
.idea/

# Every env file stays local — except the placeholder template, which is the
# only record of *which* variables a fresh clone has to set. `.env` and
# `.env*.local` alone left `.env.production` (and anything else someone
# invents) tracked, which is the same gap that published a key once already.
.env*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# build output
dist/

# Compiled apps. Never commit these: `EXPO_PUBLIC_*` values are inlined into the
# bundle at build time, so a committed .apk/.aab hands the Helius RPC key and
# every other build-time value to anyone who can `grep` the binary.
*.apk
*.aab
