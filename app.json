{
  "expo": {
    "name": "Eventerz",
    "slug": "eventerz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eventerz",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050816",
    "primaryColor": "#9945ff",
    "description": "Wallet-native event infrastructure on Solana. Discover events, RSVP on-chain, collect NFT tickets and build portable reputation.",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "xyz.eventerz.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Eventerz uses the camera to scan ticket QR codes at event check-in.",
        "NSPhotoLibraryUsageDescription": "Eventerz needs photo access so you can pick a banner image for events you create.",
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "xyz.eventerz.app",
      "adaptiveIcon": {
        "backgroundColor": "#050816",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "eventerz"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.eventerz.xyz",
              "pathPrefix": "/checkin"
            },
            {
              "scheme": "https",
              "host": "eventerz.xyz",
              "pathPrefix": "/checkin"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050816",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Eventerz uses the camera to scan ticket QR codes at event check-in.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eventerz needs photo access so you can pick a banner image for events you create."
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/with-solana-wallet-queries"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "331f0255-bd91-47f4-a736-df758f3c8b03"
      }
    },
    "owner": "eventerz",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/331f0255-bd91-47f4-a736-df758f3c8b03"
    }
  }
}
