    "@react-native-community/datetimepicker": "9.1.0",
    "@solana-mobile/mobile-wallet-adapter-protocol": "^2.2.9",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^2.2.9",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "expo": "~57.0.9",
    "expo-auth-session": "~57.0.5",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "js-base64": "^3.9.2",
    "lucide-react-native": "^1.27.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "start": "expo start",
    "android": "node scripts/run-android.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:go": "expo start --go",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prebuild": "expo prebuild --clean",
    "doctor": "npx expo-doctor",
    "android:seeker": "node scripts/run-android.mjs Seeker",
    "android:device": "node scripts/run-android.mjs --device",
    "preview": "expo start --dev-client --tunnel",
    "apk": "node scripts/build-apk.mjs",
    "android:wipe": "node scripts/run-android.mjs --wipe",
    "android:smoke": "node scripts/android-smoke.mjs",
    "scripts:check": "node --check scripts/run-android.mjs && node --check scripts/build-apk.mjs && node --check scripts/check-deps.mjs && node --check scripts/android-smoke.mjs && node --check scripts/check-build-env.mjs && node --check scripts/check-mainnet.mjs && node --check scripts/check-secrets.mjs",
    "deps:check": "node scripts/check-deps.mjs",
    "secrets:check": "node scripts/check-secrets.mjs --all",
    "postinstall": "node scripts/check-deps.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "eas-build-pre-install": "node scripts/check-build-env.mjs",
    "build:check": "npx expo-doctor@latest && npx tsc --noEmit && npx expo lint && vitest run",
    "eas:apk": "npx eas-cli build --platform android --profile preview",
    "eas:apk:prod": "npx eas-cli build --platform android --profile production",
    "eas:apk:local": "npx eas-cli build --platform android --profile preview --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:mainnet": "node scripts/check-mainnet.mjs"
  },
  "private": true,
  "description": "Eventerz - wallet-native event infrastructure on Solana. Android/iOS app for Solana Seeker."
}
