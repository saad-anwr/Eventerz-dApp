# ---------------------------------------------------------------------------
# Eventerz mobile - environment
#
# Copy to `.env` and restart Metro. Only `EXPO_PUBLIC_*` variables are readable
# from app code; anything without that prefix stays server-side.
#
#   cp .env.example .env
#
# NOTE: EXPO_PUBLIC_* values are inlined into the JS bundle at build time.
# Never put a secret (private key, service-role key, signing seed) in here.
#
# This file covers local builds only. EAS builds read their values from the EAS
# environment named by the build profile in `eas.json`, not from here:
#
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL      --value ... \
#     --environment preview --environment production --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value ... \
#     --environment preview --environment production --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_HELIUS_RPC_URL    --value ... \
#     --environment preview --environment production --visibility sensitive
#
# `--visibility sensitive` keeps a value out of build logs and the dashboard
# list. It does **not** keep it out of the app: an EXPO_PUBLIC_ variable is
# compiled into the bundle either way, so anyone can unzip the APK and read it.
# Treat the Helius URL as public and rate-limit it accordingly.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Origin used in every link the app shares (event and ticket share sheets, the
# "About Eventerz" row). Must match the website's NEXT_PUBLIC_SITE_URL - they
# name the same pages. Leave blank for production; only set it to point a
# preview build at a preview deploy.
EXPO_PUBLIC_SITE_URL=

# --- Solana ----------------------------------------------------------------
# mainnet-beta | devnet | testnet
#
# mainnet-beta is the default in code as well, so this file and a missing .env
# agree. Switch to devnet only for testing - and remember that a receipt
# recorded on devnet stores its cluster, so its explorer link stays correct
# afterwards.
EXPO_PUBLIC_SOLANA_NETWORK=mainnet-beta

# RPC endpoint. Blank falls back to the public cluster endpoint, which is fine
# for development and is **not** something to ship on mainnet: it is shared and
# aggressively rate-limited, so balance reads start failing and transfers sit at
# "confirming" while the user wonders whether their money moved.
#
# Two further things depend on it beyond raw throughput:
#  - token holdings come back with names, symbols and prices only on a DAS
#    provider (Helius). On the public endpoint the list is correct but shows
#    bare mint addresses.
#  - a locally built APK reads this file, while an EAS build reads `eas.json`.
#    Leave one blank and the same commit produces two builds that behave
#    differently, which is a miserable thing to debug. Keep them in step.
EXPO_PUBLIC_HELIUS_RPC_URL=

# Deployed Anchor program that owns events / RSVPs / check-ins.
#
# Leave BLANK until it is deployed. Every Eventerz-program action checks this and
# refuses cleanly when unset rather than fabricating a signature - RSVPs and
# tickets are real Postgres records without it.
#
# Sending SOL is the exception: a `transfer` intent is a System Program
# instruction and works regardless of this value.
#
# Deploy from `../Eventerz Program` (see that README), then paste the address
# `anchor keys sync` printed. Inlined at build time, so a change needs a rebuild.
EXPO_PUBLIC_EVENTERZ_PROGRAM_ID=

# Bubblegum merkle tree that compressed NFT tickets mint into.
EXPO_PUBLIC_MERKLE_TREE_ADDRESS=

# --- Feature flags ---------------------------------------------------------
# Wallets. `true` uses the in-memory mock adapter (works in Expo Go).
# Set to `false` only in a development build that has Mobile Wallet Adapter
# installed - see src/services/wallet/mobile-wallet-adapter.ts.
EXPO_PUBLIC_USE_MOCK_WALLET=true

# Data. `true` reads from src/mock via the repositories. Set `false` once a
# backend exists and the repositories call the API client instead.
EXPO_PUBLIC_USE_MOCK_DATA=true

EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_ENABLE_BIOMETRICS=false

# --- Auth (Supabase) -------------------------------------------------------
# Fill these two in to turn on real Google sign-in. Leave them blank and the
# app runs on mock data with the mock wallet, exactly as it does today.
#
# Dashboard -> Project Settings -> API. Full walkthrough in docs/AUTH_SETUP.md.
#
# The anon key is safe to ship - it is public by design and RLS is what
# protects your data. Never put the service_role key in an EXPO_PUBLIC_ var.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Maps (optional) ------------------------------------------------
# Optional on purpose. With a key, event screens show a Static Maps image and the
# create form uses Google Places autocomplete. Without one, place search falls
# back to OpenStreetMap/Nominatim and the map card shows the address instead of
# an image. "Open in Maps" and "Directions" work either way - they use the
# keyless `?api=1` URL scheme and hand off to the native Maps app.
#
# Restrict the key to your Android package name + SHA-1 in Google Cloud Console.
# APIs to enable: Maps Static API, Places API (New).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Backend (optional) ----------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=

# --- Translation (optional) ------------------------------------------------
# The language picker works with NO configuration. By default it uses
# MyMemory: free, keyless, and verified against every script in the picker
# (Japanese, Arabic, Chinese, Hebrew, Swahili...).
#
# Its anonymous tier is roughly 5,000 characters per day per IP - about 50,000
# with an email in TRANSLATE_EMAIL. Fine for one person exploring the app,
# nowhere near enough for a user base: the whole UI is a few thousand
# characters, so a handful of users on a cold cache would exhaust it. Strings
# are cached to disk so each is paid for once, but a launch needs the line
# below.
#
# Not a theoretical limit - a single afternoon of testing one device against it
# spent the day's allowance and it reset ~16 hours later. When that happens the
# app keeps working in English and the picker says so; nothing breaks, but
# nothing translates either.
#
# Set TRANSLATE_URL to a LibreTranslate instance and it switches to that
# instead: self-hostable, no per-request quota, whole batch in one POST. That
# is what production should run.
EXPO_PUBLIC_TRANSLATE_URL=
EXPO_PUBLIC_TRANSLATE_API_KEY=
# Raises the free MyMemory tier. Ignored when TRANSLATE_URL is set.
EXPO_PUBLIC_TRANSLATE_EMAIL=
